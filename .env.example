NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4000
APP_BASE_URL=http://localhost:4000

WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000/api
VITE_BASE_DOMAIN=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ttii
MYSQL_USER=ttii
MYSQL_PASSWORD=ttii_dev_password
MYSQL_ROOT_PASSWORD=ttii_root_password
DATABASE_URL=file:./prisma/dev.db
AUTH_SESSION_TTL_SECONDS=3600
PASSWORD_RESET_TOKEN_KEY=ttii-dev-reset-token-key-change-me
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
OTP_SIGNING_KEY=ttii-dev-otp-signing-key-change-me
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
AUTH_OTP_REQUEST_RATE_LIMIT_MAX=5
AUTH_OTP_VERIFY_RATE_LIMIT_MAX=10

EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=hello@teachersindia.in
EMAIL_FROM_NAME=Teachers' Training Institute of India
EMAIL_BREVO_API_KEY=
EMAIL_BREVO_BASE_URL=https://api.brevo.com/v3
# SMTP / Outlook / Office 365 settings (used when EMAIL_PROVIDER=smtp).
# For Outlook 365: host=smtp.office365.com, port=587, secure=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Microsoft Graph API settings (used when EMAIL_PROVIDER=msgraph).
# Register an app in Azure AD → App Registrations, add Mail.Send permission, grant admin consent.
EMAIL_MSGRAPH_CLIENT_ID=
EMAIL_MSGRAPH_CLIENT_SECRET=
EMAIL_MSGRAPH_TENANT_ID=
EMAIL_MSGRAPH_SENDER_EMAIL=

# SSO (Sign in with Google / Microsoft) — student-only.
# Leave blank to disable SSO; routes 503 and frontend hides the buttons.
# Google: create an OAuth 2.0 Client ID in Google Cloud Console (Web app type).
#   Add JS origins for each portal subdomain. Copy Client ID below.
# Microsoft: register a multi-tenant app in Azure AD App Registrations.
#   Add a Web platform redirect URI = AZURE_AD_REDIRECT_URI below.
#   Add API permission "User.Read" (delegated) + "openid profile email".
GOOGLE_OAUTH_CLIENT_ID=
AZURE_AD_TENANT_ID=common
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://learn.teachersindia.in/api/auth/sso/microsoft/callback
SSO_STATE_SIGNING_KEY=change-me-to-a-strong-random-32-char-string

OTP_PROVIDER=console
OTP_HTTP_ENDPOINT=
OTP_HTTP_AUTH_TOKEN=
OTP_HTTP_SENDER_ID=
OTP_HTTP_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Object storage (Teams live-class recordings, course assets, certificates)
#
#   local  -> dev only: writes to STORAGE_LOCAL_ROOT, not browser-playable.
#   s3     -> any S3-compatible store. TTII PRODUCTION USES DIGITALOCEAN SPACES.
#             ("s3" is the API protocol DigitalOcean Spaces speaks — this is
#             NOT Amazon AWS. See the S3_* block below for DigitalOcean values.)
#
# Recordings auto-upload here via the Teams artifacts cron and replay to
# students through short-lived signed URLs (objects stay private).
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/tmp/ttii-storage
STORAGE_LOCAL_SIGNING_KEY=ttii-dev-storage-signing-key

# DigitalOcean Spaces (set STORAGE_PROVIDER=s3 to activate). All values come
# from the DigitalOcean control panel — Spaces Object Storage + "Spaces Keys".
# PRODUCTION already runs on Spaces in sgp1 — these example values mirror it.
#   S3_BUCKET         = the Space name (production: ttii-lms-recordings)
#   S3_REGION         = the Space's datacenter slug, e.g. sgp1 (Singapore),
#                       blr1, nyc3. MUST match the Space's region (used for
#                       SigV4 signing) — do NOT leave this as an AWS region.
#   S3_ENDPOINT       = https://<region>.digitaloceanspaces.com (NO bucket)
#   S3_ACCESS_KEY_ID  = Spaces access key  (DigitalOcean -> API -> Spaces Keys)
#   S3_SECRET_ACCESS_KEY = Spaces secret key (shown once at key creation)
#   S3_FORCE_PATH_STYLE  = false uses virtual-hosted URLs (DO default, prod);
#                          true uses path-style (also works on DO + MinIO).
#   S3_PUBLIC_BASE_URL   = optional Spaces CDN/edge URL, e.g.
#                          https://ttii-lms-recordings.sgp1.cdn.digitaloceanspaces.com
#                          Only affects the stored "location" string; student
#                          playback uses signed URLs regardless.
S3_BUCKET=
S3_REGION=sgp1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

PAYMENT_PROVIDER=mock
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
PAYMENT_RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RAZORPAY_BASE_URL=https://api.razorpay.com/v1

ZOOM_PROVIDER=zoom_sdk
ZOOM_SDK_KEY=ttii-dev-zoom-sdk-key
ZOOM_SDK_SECRET=ttii-dev-zoom-sdk-secret-change-me
ZOOM_SIGNATURE_TTL_SECONDS=7200

OPENAI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_RETRY_MAX_ATTEMPTS=3
OPENAI_RETRY_BASE_DELAY_MS=250

# Ainvox cloud-telephony (admin click-to-call + recorded call history).
# Set AINVOX_PROVIDER=ainvox and fill the keys (Ainvox dashboard ->
# Settings -> API keys -> Generate) to enable the Call History feature.
# The secret key is server-side only — never expose it to the browser.
AINVOX_PROVIDER=noop
AINVOX_BASE_URL=https://app.ainvox.com
AINVOX_PUBLIC_KEY=
AINVOX_SECRET_KEY=
# Required by the call-log API. Find it via GET /api/phone-numbers (the
# accountId on your assigned virtual number).
AINVOX_ACCOUNT_ID=
AINVOX_VIRTUAL_NUMBER=
AINVOX_TIMEOUT_MS=15000
# Server-side click-to-call: unguessable token guarding the PUBLIC /api/calls/flow
# endpoint Ainvox fetches, plus a base URL Ainvox can actually reach.
AINVOX_FLOW_TOKEN=
AINVOX_PUBLIC_BASE_URL=https://admin.teachersindia.in
# Global fallback callback number (the agent leg normally rings the logged-in
# admin's profile phone; this is used when an admin has no phone on file).
AINVOX_DEFAULT_AGENT_PHONE=
# Browser dialer login (talk in the dashboard, no login screen). The server
# uses these to mint short-lived tokens that pre-authenticate the widget.
AINVOX_LOGIN_EMAIL=
AINVOX_LOGIN_PASSWORD=
