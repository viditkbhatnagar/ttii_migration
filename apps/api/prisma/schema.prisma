/// NEW auth tables (added by Node.js LMS — not part of legacy PHP app)

model auth_session {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id        Int       @db.UnsignedInt
  token_hash     String    @unique @db.VarChar(255)
  created_at     DateTime? @default(now()) @db.DateTime(0)
  updated_at     DateTime? @updatedAt @db.DateTime(0)
  expires_at     DateTime  @db.DateTime(0)
  revoked_at     DateTime? @db.DateTime(0)
  revoked_reason String?   @db.VarChar(255)
  ip_address     String?   @db.VarChar(64)
  user_agent     String?   @db.VarChar(500)

  @@index([user_id, revoked_at])
  @@index([expires_at])
}

model password_reset_token {
  id                   Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id              Int       @db.UnsignedInt
  token_hash           String    @unique @db.VarChar(255)
  created_at           DateTime? @default(now()) @db.DateTime(0)
  updated_at           DateTime? @updatedAt @db.DateTime(0)
  expires_at           DateTime  @db.DateTime(0)
  used_at              DateTime? @db.DateTime(0)
  requested_ip         String?   @db.VarChar(64)
  requested_user_agent String?   @db.VarChar(500)

  @@index([user_id, used_at])
  @@index([expires_at])
}

model auth_audit_log {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int?      @db.UnsignedInt
  event      String    @db.VarChar(100)
  identifier String?   @db.VarChar(255)
  success    Int       @default(0)
  ip_address String?   @db.VarChar(64)
  user_agent String?   @db.VarChar(500)
  details    String?   @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)

  @@index([event, created_at])
  @@index([user_id])
  @@index([created_at])
}

