  password              String?              @db.VarChar(260)
  email                 String?              @db.VarChar(50)
  whatsapp              String?              @db.VarChar(20)
  dob                   DateTime?            @db.Date
  image                 String               @db.VarChar(500)
  date_of_birth         DateTime?            @db.Date
  age                   Int?
  gender                String?              @db.VarChar(10)
  nationality           String?              @db.VarChar(100)
  marital_status        String?              @db.VarChar(50)
  aadhar_no             String?              @db.VarChar(50)
  passport_no           String?              @db.VarChar(50)
  address               String?              @db.MediumText
  native_address        String?              @db.MediumText
  country_id            String?              @db.MediumText
  state                 String?              @db.MediumText
  district              String?              @db.MediumText
  father_name           String?              @db.MediumText
  mother_name           String?              @db.MediumText
  guardian_name         String?              @db.MediumText
  second_code           Int
  second_phone          String               @db.MediumText
  whatsapp_no           Int
  emergency_name        String?              @db.VarChar(255)
  emergency_relation    String?              @db.MediumText
  emergency_phone       String?              @db.LongText
  learning_disabilities String?              @db.MediumText
  accessibility_needs   String?              @db.MediumText
  marketing_source      String?              @db.MediumText
  pipeline              String?              @db.VarChar(255)
  pipeline_user         Int?
  highest_qualification String?              @db.MediumText
  previous_school       String?              @db.MediumText
  year_of_passing       String?              @db.VarChar(10)
  percentage_or_grade   String?              @db.VarChar(1000)
  teaching_experience   String?              @db.MediumText
  employment_status     String?              @db.MediumText
  organization_name     String?              @db.MediumText
  experience_years      String?              @db.MediumText
  designation           String?              @db.MediumText
  industry_sector       String?              @db.MediumText
  batch_id              Int?
  student_id            Int?
  course_id             Int?
  enrollment_date       String?              @db.Text
  enrollment_status     String?              @default("Active") @db.Text
  biography             String?              @db.MediumText
  mode_of_study         String?              @db.Text
  preferred_language    String?              @db.Text
  status                applications_status? @default(pending)
  is_converted          Int?                 @default(0)
  converted_by          Int?
  converted_at          DateTime?            @db.DateTime(0)
  // Added 2026-04-26 per Naji's TTII LMS Correction_new_corrections doc.
  offering_id              Int?
  certificate_combination_id Int?
  lead_source              String?  @db.VarChar(120)
  current_occupation       String?  @db.VarChar(120)
  application_discount     Decimal? @db.Decimal(10, 2)
  application_gst_percent  Decimal? @db.Decimal(5, 2)
  application_final_fee    Decimal? @db.Decimal(10, 2)
  created_at            DateTime?            @db.DateTime(0)
  updated_at            DateTime?            @db.DateTime(0)
  deleted_at            DateTime?            @db.DateTime(0)
  created_by            Int?
  updated_by            Int?
  deleted_by            Int?
}

/// Education Pathway entries linked to an application — multi-row sub-form.
/// Added 2026-04-26 per Naji's correction doc.
model application_education_pathway {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  application_id Int
  qualification  String    @db.VarChar(255)
  specialization String?   @db.VarChar(255)
  institution    String?   @db.VarChar(255)
  year_passed    String?   @db.VarChar(10)
  marks          String?   @db.VarChar(50)
  board          String?   @db.VarChar(255)
  position       Int?      @default(0)
  created_at     DateTime? @default(now()) @db.DateTime(0)
  updated_at     DateTime? @default(now()) @db.DateTime(0)
  created_by     Int?
  updated_by     Int?

  @@index([application_id])
}

