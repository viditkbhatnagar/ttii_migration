# =============================================================
# TTII Node.js LMS — production nginx site (3-subdomain + HTTPS)
#
# This is the LIVE config running at /etc/nginx/sites-available/ttii-lms
# on the deploy droplet. Committed here for reference + reproducibility.
#
# The HTTPS server block + cert paths were generated by Certbot
# (certbot --nginx -d admin.teachersindia.in -d learn. -d admissions.
# --redirect). To re-run on a fresh droplet, start with just the HTTP
# block and let certbot add the HTTPS one.
# =============================================================

upstream ttii_api {
    server 127.0.0.1:4000;
    keepalive 32;
}

# Main site — 3 subdomains share the same SPA bundle.
# Portal selection (admin / student / centre) happens client-side in
# apps/web/src/lib/subdomain.ts using VITE_BASE_DOMAIN + window.location.hostname.
server {
    server_name admin.teachersindia.in learn.teachersindia.in admissions.teachersindia.in;

    # Course documents (multi-chapter PDFs etc.) can be large. Must match the
    # @fastify/multipart fileSize limit in apps/api/src/app.ts (200 MB). If this
    # is smaller, nginx 413s with an HTML page before the request reaches the API
    # and the upload client sees "Unexpected token '<' … is not valid JSON".
    client_max_body_size 200M;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml+rss text/xml font/opentype image/svg+xml;

    root /opt/ttii-lms/apps/web/dist;
    index index.html;

    location /api/ {
        proxy_pass http://ttii_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Assignment uploads (Naji 2026-08-17): a student on a weak mobile
        # uplink could not push a 25MB PDF through inside nginx's
        # client_body_timeout, which DEFAULTS TO 60s and was never set here.
        # nginx answered 408 and closed the connection, and a closed connection
        # reaches the browser as a network error — the student saw "Failed to
        # fetch", not a status code, so it read as the app being broken.
        # Confirmed in the access log: 3 x 408 from one student's token, minutes
        # apart, their IP changing between attempts (mobile signal), against 17
        # successful submits from other phones.
        client_body_timeout 300s;
        proxy_send_timeout 300s;
        # The API buffers the whole upload in memory and then pushes it to
        # object storage before replying, so the response itself can be slow on
        # a large file.
        proxy_read_timeout 180s;
        # Large document uploads need a longer send window than the 60s default.
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, must-revalidate";
    }

    access_log /var/log/nginx/ttii-lms.access.log;
    error_log  /var/log/nginx/ttii-lms.error.log;

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/admin.teachersindia.in/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/admin.teachersindia.in/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# Close the raw-IP / unknown-hostname door. Anyone hitting the server
# on anything other than the 3 subdomains gets a silent reset.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# HTTP → HTTPS redirect for the 3 subdomains (managed by Certbot via --redirect).
server {
    if ($host = admissions.teachersindia.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = learn.teachersindia.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = admin.teachersindia.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name admin.teachersindia.in learn.teachersindia.in admissions.teachersindia.in;
    return 404; # managed by Certbot
}
