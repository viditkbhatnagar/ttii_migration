# =============================================================
# nginx site for TTII Node.js LMS
# Place at /etc/nginx/sites-available/ttii-lms on the new droplet.
# Symlink:  ln -s /etc/nginx/sites-available/ttii-lms /etc/nginx/sites-enabled/
# Then run Certbot for SSL.
# =============================================================

# --- Shared upstream pointing at the Fastify API on PM2 ---
upstream ttii_api {
    server 127.0.0.1:4000;
    keepalive 32;
}

# --- Static SPA root (built apps/web/dist) ---
# All three subdomains serve the same SPA bundle; portal selection
# is based on window.location.hostname inside the React app.

server {
    listen 80;
    server_name admin.teachersindia.in learn.teachersindia.in admissions.teachersindia.in;

    # ACME HTTP-01 challenge (Certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Everything else → HTTPS (Certbot will rewrite this on --nginx)
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name admin.teachersindia.in learn.teachersindia.in admissions.teachersindia.in;

    # SSL certs filled in by Certbot
    # ssl_certificate /etc/letsencrypt/live/admin.teachersindia.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/admin.teachersindia.in/privkey.pem;

    client_max_body_size 50M;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml+rss text/xml application/x-font-ttf application/x-font-otf font/opentype image/svg+xml;

    root /opt/ttii-lms/apps/web/dist;
    index index.html;

    # API → Fastify on :4000
    location /api/ {
        proxy_pass http://ttii_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 90s;
    }

    # Static assets — long cache, immutable hashes
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, must-revalidate";
    }

    access_log /var/log/nginx/ttii-lms.access.log;
    error_log /var/log/nginx/ttii-lms.error.log;
}
