# =============================================================
# TTII LMS — production environment template
# Copy to /opt/ttii-lms/.env on the new droplet and fill in REPLACE_ME values.
# DO NOT commit the filled-in version.
# =============================================================

NODE_ENV=production

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
APP_BASE_URL=https://admin.teachersindia.in

# --- Web (build-time vars; baked into apps/web/dist) ---
WEB_PORT=5173
VITE_API_BASE_URL=https://admin.teachersindia.in/api
VITE_BASE_DOMAIN=teachersindia.in

# --- Database (live MariaDB on existing droplet via VPC private IP) ---
# REPLACE <existing_droplet_private_ip> with the actual VPC IP after droplet B is created.
MYSQL_HOST=REPLACE_ME_existing_droplet_private_ip
MYSQL_PORT=3306
MYSQL_DATABASE=lms_ttii
MYSQL_USER=lms_ttii
MYSQL_PASSWORD=rsxH9#lB3-D-uEti
DATABASE_URL="mysql://lms_ttii:rsxH9%23lB3-D-uEti@REPLACE_ME_existing_droplet_private_ip:3306/lms_ttii"

# --- Auth / sessions ---
AUTH_SESSION_TTL_SECONDS=3600
PASSWORD_RESET_TOKEN_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
OTP_SIGNING_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
AUTH_OTP_REQUEST_RATE_LIMIT_MAX=5
AUTH_OTP_VERIFY_RATE_LIMIT_MAX=10

# --- Email: Microsoft Graph (already configured on existing prod) ---
EMAIL_PROVIDER=msgraph
EMAIL_FROM_ADDRESS=info@teachersindia.in
EMAIL_FROM_NAME=Teachers Training Institute of India
EMAIL_MSGRAPH_CLIENT_ID=REPLACE_ME_from_existing_php_env
EMAIL_MSGRAPH_CLIENT_SECRET=REPLACE_ME_from_existing_php_env
EMAIL_MSGRAPH_TENANT_ID=REPLACE_ME_from_existing_php_env
EMAIL_MSGRAPH_SENDER_EMAIL=info@teachersindia.in

# --- OTP ---
OTP_PROVIDER=console
OTP_HTTP_ENDPOINT=
OTP_HTTP_AUTH_TOKEN=
OTP_HTTP_SENDER_ID=
OTP_HTTP_TIMEOUT_MS=5000

# --- Storage (local for now; switch to S3/Spaces later) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/opt/ttii-lms/storage
STORAGE_LOCAL_SIGNING_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32
S3_BUCKET=
S3_REGION=blr1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# --- Payments ---
PAYMENT_PROVIDER=mock
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=
PAYMENT_RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# --- Zoom ---
ZOOM_PROVIDER=zoom_sdk
ZOOM_SDK_KEY=REPLACE_ME
ZOOM_SDK_SECRET=REPLACE_ME
ZOOM_SIGNATURE_TTL_SECONDS=7200

# --- OpenAI ---
OPENAI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_RETRY_MAX_ATTEMPTS=3
OPENAI_RETRY_BASE_DELAY_MS=250
